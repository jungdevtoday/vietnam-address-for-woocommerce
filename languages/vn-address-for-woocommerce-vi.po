#. Plugin Name of the plugin
#: vn-address-woocommerce.php includes/class-vn-address-admin.php:85
msgid "Vietnam Address for WooCommerce"
msgstr "Vietnam Address for WooCommerce"

#. Plugin URI of the plugin
#: vn-address-woocommerce.php
msgid "https://jungdev.com/plugins/vn-address-for-woocommerce"
msgstr "https://jungdev.com/plugins/vn-address-for-woocommerce"

#. Description of the plugin
#: vn-address-woocommerce.php
msgid ""
"Integrates the latest Vietnamese administrative addresses into WooCommerce. "
"Supports converting old addresses to new addresses."
msgstr ""
"Tích hợp địa chỉ hành chính Việt Nam mới nhất vào WooCommerce, hỗ trợ chuyển "
"đổi địa chỉ cũ sang địa chỉ mới."

#. Author of the plugin
#: vn-address-woocommerce.php
msgid "jungdev"
msgstr "jungdev"

#. Author URI of the plugin
#: vn-address-woocommerce.php
msgid "https://jungdev.com"
msgstr "https://jungdev.com"

